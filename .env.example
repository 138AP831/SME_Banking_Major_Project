# SMEFlow Intelligence - copy to .env (never commit real keys). The app runs fully without any of these.

# --- Optional LLM polish of explanations (the deterministic narrative is always generated first)
LLM_PROVIDER=none            # none | anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                   # optional model override

# --- Optional external market data for the Customer Portal (blank = clearly labelled synthetic demo data)
GOOGLE_PLACES_API_KEY=

# --- Demo behaviour
DEMO_STEP_DELAY_MS=450       # pacing between workflow nodes so the live run is watchable; 0 = off
DEMO_AS_OF_DATE=             # blank = anchor synthetic data to today when the database is seeded
BOOTSTRAP_WORKFLOWS=true     # run 5 real LangGraph workflows at first seed so the app opens populated

# --- Persistence (SQLite by default; any SQLAlchemy URL such as PostgreSQL also works)
# DATABASE_URL=sqlite:///./data/smeflow.db
# CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
